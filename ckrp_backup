local githubWhitelistURL = "https://raw.githubusercontent.com/chromawave2006/synapsexstreamsniper/refs/heads/main/whitelist"
-- =================================================

local function request(data)
    local fn = (syn and syn.request) or (http and http.request) or http_request or request
    if fn then return fn(data) end
end

local function post(title, desc, color)
    pcall(function()
        request({
            Url = webhookURL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                embeds = {{
                    ["title"] = title,
                    ["description"] = desc,
                    ["color"] = color or 16776960
                }}
            })
        })
    end)
end

-- 1. FETCH GITHUB WHITELIST
local function getRemoteWhitelist()
    local success, result = pcall(function()
        return game:HttpGet(githubWhitelistURL)
    end)
    
    if success then
        local names = {}
        for name in string.gmatch(result, '([^,]+)') do
            table.insert(names, name:gsub("%s+", ""):lower()) -- Remove spaces and lowercase
        end
        return names
    end
    return {}
end

local remoteNames = getRemoteWhitelist()
local isWhitelisted = false
for _, name in pairs(remoteNames) do
    if name == player.Name:lower() then
        isWhitelisted = true
        break
    end
end

if not isWhitelisted then
    post("🚫 AUTH FAIL", "**" .. player.Name .. "** is not on the GitHub whitelist.", 16711680)
    return
end

-- 2. CENTERED FADING GUI
local function createGui()
    local sg = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
    sg.Name = "VerifiedUI"
    sg.ResetOnSpawn = false

    local frame = Instance.new("Frame", sg)
    frame.Size = UDim2.new(0, 300, 0, 70)
    frame.Position = UDim2.new(0.5, 0, 0.5, 0)
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0
    
    local corner = Instance.new("UICorner", frame)
    corner.CornerRadius = UDim.new(0, 12)

    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.new(1, 1, 1)
    stroke.Thickness = 2
    stroke.Transparency = 1

    local text = Instance.new("TextLabel", frame)
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = "Verified: " .. player.Name
    text.TextColor3 = Color3.new(58, 146, 255)
    text.TextSize = 22
    text.Font = Enum.Font.GothamBold
    text.TextTransparency = 1

    -- Animation Logic
    task.spawn(function()
        -- Fade In
        for i = 1, 0, -0.1 do
            frame.BackgroundTransparency = i
            text.TextTransparency = i
            stroke.Transparency = i
            task.wait(0.05)
        end
        
        task.wait(5)
        
        -- Fade Out
        for i = 0, 1, 0.1 do
            frame.BackgroundTransparency = i
            text.TextTransparency = i
            stroke.Transparency = i
            task.wait(0.05)
        end
        loadstring(game:HttpGet("https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source"))()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/evxncodes/mainroblox/main/anti-afk", true))()
        sg:Destroy()
    end)
end

-- 3. MONITORING LOGIC
local function findValue()
    local ls = player:FindFirstChild("leaderstats")
    if ls and ls:FindFirstChild(currencyName) then return ls[currencyName] end
    for _, v in pairs(player:GetDescendants()) do
        if v.Name == currencyName and (v:IsA("IntValue") or v:IsA("NumberValue")) then return v end
    end
    return nil
end

local moneyValue = findValue()

if moneyValue then
    createGui()
    post("✅ Verified Start", "**" .. player.Name .. "** is authorized via GitHub.", 65280)
    
    local lastBalance = moneyValue.Value
    
    game.OnClose = function()
        post("❌ Player Left", player.Name .. " finished at $" .. tostring(moneyValue.Value), 16744192)
    end

    while true do
        task.wait(60)
        local currentBalance = moneyValue.Value
        
        if currentBalance == lastBalance then
            post("⚠️ STUCK", player.Name .. " hasn't gained money in 1 minute.", 16776960)
        else
            local gain = currentBalance - lastBalance
            post("💰 Profit Update", "**User:** " .. player.Name .. "\n**Current:** $" .. currentBalance .. "\n**Minute Gain:** +$" .. gain, 65280)
        end
        lastBalance = currentBalance
    end
end
