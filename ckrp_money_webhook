loadstring(game:HttpGet("https://raw.githubusercontent.com/evxncodes/mainroblox/main/anti-afk", true))()

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
local usd = player:WaitForChild("leaderstats"):WaitForChild("USD")

local webhookURL = "https://discord.com/api/webhooks/1500212577391874189/TmdztJK1hWZEpwJh3XxvZwc9BrrYEkQ26755NLvoKfxBNxPjalT8fFQ3rk2Csw4o2e7M"

local lastValue = usd.Value


local function sendWebhook(title, description, color)
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if req then
        req({
            Url = webhookURL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                ["embeds"] = {{
                    ["title"] = title,
                    ["description"] = description,
                    ["color"] = color or 16776960,
                    ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
                }}
            })
        })
    end
end


game.OnClose = function()
    sendWebhook(
        "❌ Player Left / Game Closed", 
        "User **" .. player.Name .. "** has disconnected or the game closed.\nFinal Balance: **$" .. tostring(usd.Value) .. "**", 
        16711680 -- Red
    )
    task.wait(2) -- Give the webhook a moment to send before the process kills
end

sendWebhook(
    "🚀 Script Started", 
    "The money monitor is now **ACTIVE**.\nInitial Balance: **$" .. tostring(lastValue) .. "**\nInterval: **60 Seconds**", 
    3447003 -- Blue
)


while true do
    task.wait(60)
    
    local currentValue = usd.Value
    
    if currentValue == lastValue then
    
        sendWebhook(
            "⚠️ GLITCH STUCK", 
            "Balance is frozen at **$" .. tostring(currentValue) .. "**. Restart the money glitch!", 
            16744192 -- Orange
        )
    else
       
        local gain = currentValue - lastValue
        sendWebhook(
            "💰 Minute Update", 
            "Current Balance: **$" .. tostring(currentValue) .. "**\nEarned in last minute: **+$" .. tostring(gain) .. "**", 
            65280 -- Green
        )
    end
    
    lastValue = currentValue
end
