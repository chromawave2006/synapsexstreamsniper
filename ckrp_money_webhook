local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
local usd = player:WaitForChild("leaderstats"):WaitForChild("USD")

local webhookURL = "https://discord.com/api/webhooks/1500212577391874189/TmdztJK1hWZEpwJh3XxvZwc9BrrYEkQ26755NLvoKfxBNxPjalT8fFQ3rk2Csw4o2e7M"

local lastSent = 0
local cooldown = 15 -- Seconds to wait between messages (to avoid Discord bans)

local function sendWebhook(val)
    local now = tick()
    if (now - lastSent) < cooldown then return end -- Skip if sending too fast
    lastSent = now

    local req = (syn and syn.request) or (http and http.request) or http_request or request
    
    if req then
        req({
            Url = webhookURL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                ["embeds"] = {{
                    ["title"] = "💰 Money Update",
                    ["description"] = "**" .. player.Name .. "** now has: **$" .. string.format("%.2f", val) .. "**",
                    ["color"] = 16776960,
                    ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
                }}
            })
        })
    end
end


usd.Changed:Connect(function(newVal)
    sendWebhook(newVal)
end)

print("Real-time monitoring active for USD.")
