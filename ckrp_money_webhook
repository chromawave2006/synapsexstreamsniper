loadstring(game:HttpGet("https://raw.githubusercontent.com/evxncodes/mainroblox/main/anti-afk", true))()

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
local usd = player:WaitForChild("leaderstats"):WaitForChild("USD")

local webhookURL = "https://discord.com/api/webhooks/1500212577391874189/TmdztJK1hWZEpwJh3XxvZwc9BrrYEkQ26755NLvoKfxBNxPjalT8fFQ3rk2Csw4o2e7M"

local lastValue = usd.Value

-- Reusable Webhook Function
local function sendWebhook(title, description, color)
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if req then
        local success, err = pcall(function()
            req({
                Url = webhookURL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({
                    ["embeds"] = {{
                        ["title"] = title,
                        ["description"] = description,
                        ["color"] = color or 16776960,
                        ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ"),
                        ["footer"] = {["text"] = "User: " .. player.Name}
                    }}
                })
            })
        end)
        if not success then warn("Webhook failed to send: " .. tostring(err)) end
    end
end

-- 1. STARTUP NOTIFICATION
sendWebhook(
    "🚀 Script Started", 
    "The money monitor is now **ACTIVE**.\nInitial Balance: **$" .. tostring(lastValue) .. "**\nInterval: **60 Seconds**", 
    3447003 -- Blue
)

-- 2. LEAVE DETECTION
game.OnClose = function()
    sendWebhook(
        "❌ Player Left / Game Closed", 
        "User **" .. player.Name .. "** disconnected.\nFinal Balance: **$" .. tostring(usd.Value) .. "**", 
        16711680 -- Red
    )
    task.wait(2)
end

print("Monitor initialized successfully.")

-- 3. MINUTE LOOP
while true do
    task.wait(60) -- Wait exactly 1 minute
    
    local currentValue = usd.Value
    
    if currentValue == lastValue then
        -- No money change
        sendWebhook(
            "⚠️ GLITCH STUCK", 
            "Balance hasn't moved from **$" .. tostring(currentValue) .. "** in the last minute. You might need to restart the glitch!", 
            16744192 -- Orange
        )
    else
        -- Progress update
        local gain = currentValue - lastValue
        sendWebhook(
            "💰 Minute Update", 
            "Current Balance: **$" .. tostring(currentValue) .. "**\nProfit this minute: **+$" .. tostring(gain) .. "**", 
            65280 -- Green
        )
    end
    
    lastValue = currentValue
end
