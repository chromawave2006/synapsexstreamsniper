-- 1. WEBHOOK UTILITY
local function post(title, desc, color)
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if not req then return end
    task.spawn(function()
        pcall(function()
            req({
                Url = webhookURL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({
                    embeds = {{["title"] = title, ["description"] = desc, ["color"] = color}}
                })
            })
        end)
    end)
end

-- 2. AUTHENTICATION (GITHUB)
local function getRemoteWhitelist()
    local success, result = pcall(function() return game:HttpGet(githubWhitelistURL) end)
    if success then
        local names = {}
        for name in string.gmatch(result, '([^,%s\n\r]+)') do table.insert(names, name:lower()) end
        return names
    end
    return {}
end

local remoteNames = getRemoteWhitelist()
