-- ================= MONITORING ENGINE =================
local function findValue()
    local ls = player:FindFirstChild("leaderstats")
    if ls and ls:FindFirstChild(currencyName) then return ls[currencyName] end
    for _, v in pairs(player:GetDescendants()) do
        if v.Name == currencyName and (v:IsA("IntValue") or v:IsA("NumberValue")) then return v end
    end
end

local moneyValue = findValue()

if moneyValue then
    local initial = math.floor(moneyValue.Value)
    local last = initial
    
    -- INITIAL START WEBHOOK
    post("✅ Verified Start", 
        "**User:** " .. player.Name .. 
        "\n**Current Balance:** $" .. initial .. 
        "\n**Status:** Running", 
        65280
    )

    -- LIVE UI UPDATER (ROUNDED)
    task.spawn(function()
        while task.wait(0.5) do
            local curRounded = math.floor(moneyValue.Value)
            balanceVal.Text = "$" .. curRounded
            gainVal.Text = "+$" .. (curRounded - initial)
            
            local uptime = os.time() - startTime
            uptimeVal.Text = string.format("%02d:%02d:%02d", math.floor(uptime/3600), math.floor((uptime%3600)/60), uptime%60)
        end
    end)

    -- 60-SECOND WEBHOOK LOOP (WITH BALANCE)
    while task.wait(60) do
        local cur = math.floor(moneyValue.Value)
        
        if cur == last then
            -- Sending balance even when stuck so you can see where it stopped
            post("⚠️ STUCK", 
                "**User:** " .. player.Name .. 
                "\n**Current Balance:** $" .. cur .. 
                "\n**Status:** No gain in 60s", 
                16776960
            )
        else
            -- Sending gain and total balance
            post("💰 MONEY UPDATE", 
                "**User:** " .. player.Name .. 
                "\n**Current Balance:** $" .. cur .. 
                "\n**Minute Profit:** +$" .. (cur - last), 
                65280
            )
        end
        last = cur
    end
end
