-- 4. LOGIC & WEBHOOK LOOP
local function findValue()
    local ls = player:FindFirstChild("leaderstats")
    if ls and ls:FindFirstChild(currencyName) then return ls[currencyName] end
    for _, v in pairs(player:GetDescendants()) do
        if v.Name == currencyName and (v:IsA("IntValue") or v:IsA("NumberValue")) then return v end
    end
end

local moneyValue = findValue()
if moneyValue then
    local initialBalance = math.floor(moneyValue.Value)
    local lastBalance = math.floor(moneyValue.Value)
    
    post("✅ System Online", "**User:** " .. player.Name .. "\n**Starting:** $" .. initialBalance, 65280)

    -- Rapid UI Update
    task.spawn(function()
        while task.wait(0.5) do
            local rawCur = moneyValue.Value
            local cur = math.floor(rawCur) -- REMOVES EXTRA NUMBERS
            
            balanceVal.Text = "$" .. cur
            gainVal.Text = "+$" .. (cur - initialBalance)
            uptimeVal.Text = formatTime(os.time() - startTime)
        end
    end)

    -- 60s Webhook Loop
    while task.wait(60) do
        local current = math.floor(moneyValue.Value)
        if current == lastBalance then
            post("⚠️ IDLE / STUCK", "**" .. player.Name .. "** has not gained money in 60s.", 16776960)
        else
            post("💰 Update", "**Balance:** $" .. current .. "\n**Minute Gain:** +$" .. (current - lastBalance), 65280)
        end
        lastBalance = current
    end
end
