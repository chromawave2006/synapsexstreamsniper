-- 1. UTILITIES
local function request(data)
    local fn = (syn and syn.request) or (http and http.request) or http_request or request
    if fn then return fn(data) end
end

local function post(title, desc, color)
    task.spawn(function()
        pcall(function()
            request({
                Url = webhookURL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({
                    embeds = {{["title"] = title, ["description"] = desc, ["color"] = color or 16776960}}
                })
            })
        end)
    end)
end

local function formatTime(seconds)
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = seconds % 60
    return string.format("%02d:%02d:%02d", h, m, s)
end

-- 2. AUTHENTICATION (GITHUB)
local function getRemoteWhitelist()
    local success, result = pcall(function() return game:HttpGet(githubWhitelistURL) end)
    if success then
        local names = {}
        for name in string.gmatch(result, '([^,%s\n\r]+)') do table.insert(names, name:lower()) end
        return names
    end
    return {}
end

local remoteNames = getRemoteWhitelist()
